# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; `.env.example` is committed as the shape-of-secrets reference.
#
# Every value below is a PLACEHOLDER. Never commit a real key to this file.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------

# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME


# ---------------------------------------------------------------------------
# LLM provider (required for every AI feature)
# ---------------------------------------------------------------------------

# "openai" or "nvidia". NOTE: if this is unset the code defaults to "nvidia",
# so set it explicitly rather than relying on the default.
LLM_PROVIDER=openai

# Only the key for the provider selected above is actually used.
OPENAI_API_KEY=sk-REPLACE_ME
NVIDIA_API_KEY=nvapi-REPLACE_ME

# Optional. Overrides the provider's default model
# (openai -> gpt-4o-mini, nvidia -> mistralai/mistral-nemotron).
# AI_MODEL_NAME=gpt-4o-mini


# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR. DEBUG adds node_started / tool_started lines.
LOG_LEVEL=INFO

# console = aligned and readable while developing
# json    = one JSON object per line, for anything that ships logs
LOG_FORMAT=console


# ---------------------------------------------------------------------------
# LangSmith tracing (optional, but this is the project's trace store)
# ---------------------------------------------------------------------------

# READ THIS BEFORE SETTING A KEY:
# An API key ALONE does nothing. The library only traces when a tracing FLAG is
# literally the string "true". This project previously had the key and the project
# name set with no flag, and therefore produced zero traces while appearing
# configured. Set LANGSMITH_TRACING=true to actually send traces.
#
# The library checks, in order: LANGSMITH_TRACING_V2, LANGCHAIN_TRACING_V2,
# LANGSMITH_TRACING, LANGCHAIN_TRACING. The LANGSMITH_ names are the current
# spelling; the LANGCHAIN_ ones are the legacy aliases and still work.
#
# The app logs `tracing_status` at startup and warns on a key-without-flag setup,
# so you can confirm which state you are in without opening the dashboard.

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_REPLACE_ME
LANGSMITH_PROJECT=ai-pharmacy-ecosystem

# Only needed for self-hosted or EU-region LangSmith. Leave unset for the default.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------------------------------------------------------------------------
# Locale
# ---------------------------------------------------------------------------

# IANA timezone the pharmacy operates in. Named periods ("last month", "today")
# resolve in THIS zone, not UTC. A missing or misspelt zone fails at startup rather
# than silently falling back, because a silent fallback shifts every period boundary
# by hours. See docs/business_queries.md.
APP_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Expiry Risk Agent
# ---------------------------------------------------------------------------

# Risk thresholds, in days to expiry. A batch is only ever flagged when it has
# EXCESS stock (more than is expected to sell in time) - these decide how urgent
# that excess is. Must satisfy critical < warning <= horizon, or the app refuses
# to start rather than leave a risk band unreachable.

# About the shortest window in which a pharmacist can realistically act.
EXPIRY_CRITICAL_DAYS=7

# The normal planning cycle, and what "expiring soon" usually means.
EXPIRY_WARNING_DAYS=30

# Far enough out that slow movers surface while there is still time to stop
# reordering them.
EXPIRY_HORIZON_DAYS=90

# How far back to look when estimating demand. Long enough to smooth week-to-week
# noise, short enough to reflect how a product sells now rather than last season.
# This is a historical average, NOT a forecast - see docs/agents/expiry_risk_agent.md.
EXPIRY_DEMAND_LOOKBACK_DAYS=90


# ---------------------------------------------------------------------------
# WhatsApp refill reminders (M6.3) — optional, OFF by default
# ---------------------------------------------------------------------------
#
# With WHATSAPP_ENABLED unset or false the application uses an in-memory fake
# provider: the whole notification pipeline runs, records state and is fully
# testable, but no HTTP request ever leaves the machine. Cloning this repo and
# running the sweep cannot message a real customer.
#
# NEVER commit real values. .env is gitignored; this file is the shape only.

WHATSAPP_ENABLED=false

# Meta Cloud API credentials. From developers.facebook.com -> your app ->
# WhatsApp -> API Setup.
WHATSAPP_ACCESS_TOKEN=EAAG...replace_me
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Optional overrides — the defaults are usually right.
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_BASE_URL=https://graph.facebook.com

# The approved template. Must already exist and be APPROVED in your WhatsApp
# Business Account, in this exact language, with exactly two body parameters:
#   {{1}} customer name   {{2}} pharmacy name
WHATSAPP_TEMPLATE_NAME=refill_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en

# Appears in the message body as {{2}}.
PHARMACY_NAME=Apna Medical

# Webhook security.
#   VERIFY_TOKEN — any string you choose; paste the same value into Meta's
#                  webhook configuration screen.
#   APP_SECRET   — from Meta app -> Settings -> Basic -> App Secret. Used to
#                  validate X-Hub-Signature-256. Without it every webhook is
#                  rejected, which is deliberate: an unsigned endpoint would let
#                  anyone mark any message as read.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose_a_long_random_string
WHATSAPP_APP_SECRET=replace_me
